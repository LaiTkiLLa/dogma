# PostgreSQL credentials (used by docker compose + DATABASE_URL for containers)
POSTGRES_DB=dogma
POSTGRES_USER=dogma
POSTGRES_PASSWORD=dogma

# Inside Docker Compose services use hostname `postgres` (set automatically in compose).
# For local runs without Docker, point at host PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dogma
DATABASE_URL=postgresql+psycopg://dogma:dogma@postgres:5432/dogma

# API listen / publish port
APP_PORT=10000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

DOGMA_BASE_URL=https://service.dogma.ru/api/layouts-filter
DOGMA_PUBLIC_BASE_URL=https://dogma.ru
DOGMA_REQUEST_TIMEOUT=30
DOGMA_PAGE_LIMIT=100
DOGMA_REQUEST_DELAY_SECONDS=2
DOGMA_SYNC_INTERVAL_SECONDS=3600
DOGMA_RETRY_DELAY_SECONDS=10

WORKER_INTERVAL_SECONDS=3600
WORKER_ENABLED=true

APP_LOG_LEVEL=INFO
CHAT_MAX_TOOL_ITERATIONS=3
